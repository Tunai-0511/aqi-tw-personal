# AgentAQI .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Streamlit secrets — never commit user-provided tokens
.streamlit/secrets.toml
*.secrets

# IDE / editor
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build artifacts
build/
dist/
*.tar.gz

# Logs
*.log

# Local SQLite TSDB cache
*.sqlite
*.sqlite-journal
agent_aqi.sqlite

# Node
node_modules/

# Claude / Gemini agent
.claude/

# Teammate module (external/cal-env-watch) — OAuth / API-key JSONs must never enter the repo
# (vendored files audited: zero embedded secrets; these patterns are a tripwire)
external/**/secrets/
google-cal*.json
moenv.json
