# Copy to .env.hermes and keep it out of git.
OPENROUTER_API_KEY=
# Or configure another provider supported by Hermes.

API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=replace-with-a-long-random-api-key
HERMES_GATEWAY_BOOTSTRAP_STATE=running

# Central bot credentials are optional until platform setup is complete.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
