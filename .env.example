# Core AQI backend
EPA_KEY=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AQI_CORS=http://127.0.0.1:8801
PUBLIC_APP_URL=http://127.0.0.1:8801

# Supabase (service-role key must never be placed in docs/ or committed)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INTEGRATION_STATE_SECRET=replace-with-at-least-32-random-characters

# Local UI test without Supabase/platform credentials. Never enable in production.
INTEGRATION_DEV_MODE=0

# Discord central bot / OAuth installation
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/discord/callback
DISCORD_BOT_PERMISSIONS=117760

# Hermes profile provisioning: disabled | cli | docker
HERMES_PROVISION_MODE=disabled
HERMES_CLI=hermes
HERMES_CONTAINER=hermes
HERMES_TEMPLATE_PROFILE=
HERMES_PROVISION_TIMEOUT=45
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_API_TIMEOUT=55
